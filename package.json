{
  "name": "shadowgate",
  "version": "1.17.1",
  "description": "ShadowGate — a private, self-hosted gate that turns ChatGPT sessions into an OpenAI-compatible API, with a hardened admin console.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify:session": "node scripts/verify-session.mjs",
    "check:web": "node scripts/check-web.mjs",
    "test": "npm run check:web && node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucifer-xD/shadowgate.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "gpt-tokenizer": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.16.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2"
  }
}
