# ── ShadowGate configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Every value has a safe default except secrets.

# Port the gateway listens on (nginx/Caddy proxies 443 -> this)
PORT=4315
# Interface to bind. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes it directly.
BIND_HOST=127.0.0.1

# Public URL of this deployment (drives the Secure cookie flag + docs links)
PUBLIC_BASE_URL=https://gate.example.com

# ── Secrets (generate with: openssl rand -hex 32) ────────────────────────
# Signs admin sessions + encrypts session tokens / access tokens at rest.
# Changing it afterwards makes every stored session unreadable.
SECRET_KEY=
# Admin console login. Leave ADMIN_PASSWORD empty on first boot and a strong
# password is generated, printed to the log once, and you are asked to change it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# One-shot: set ADMIN_PASSWORD_RESET=1 together with ADMIN_PASSWORD to force a
# password reset on the next start (remove it again afterwards).
# ADMIN_PASSWORD_RESET=1

# ── ChatGPT session tokens ──────────────────────────────────────────────
# Comma-separated __Secure-next-auth.session-token values imported on boot.
# Prefer adding sessions from the console (keeps the device fingerprint).
SESSION_TOKENS=

# ── Guard rails ─────────────────────────────────────────────────────────
# Default per-key limits (editable per key in the console). Agent harnesses make
# one request per tool round, so keep the per-minute limit generous.
DEFAULT_KEY_RPM=120
DEFAULT_KEY_RPD=20000
# Reverse proxy hops to trust for the client IP (lockouts, allowlist, logs).
# 0 = none (direct), 1 = nginx/Caddy on the same box, 2 = Cloudflare -> nginx
# without the real-ip module. Any other value is a hop count.
TRUST_PROXY=1
# Optional: comma-separated IPs/CIDRs allowed to reach /admin and /api/admin
# ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.1.4
